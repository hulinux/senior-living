---
interface Props {}

const { } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path;
const isSectionActive = (section: string) => currentPath.startsWith(section);
---

<header class="bg-white dark:bg-gray-900 shadow-sm fixed w-full z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-20">
      <div class="flex items-center">
        <a href="/" class="flex-shrink-0 flex items-center">
          <img src="/images/dingtai_anan_banner.png" alt="鼎泰养老服务" class="h-10 w-auto mr-3" />
          <!-- <span class="text-2xl font-bold text-purple-700 dark:text-purple-400">鼎泰养老服务</span> -->
        </a>
      </div>
      
      <!-- Desktop Navigation -->
      <nav class="hidden md:ml-6 md:flex md:items-center md:space-x-8">
        <div class="relative group">
          <a 
            href="/" 
            class={`inline-flex items-center px-1 pt-1 text-sm font-medium ${isActive('/') ? 'text-purple-600 dark:text-purple-400' : 'text-gray-900 dark:text-white hover:text-purple-600 dark:hover:text-purple-400'}`}
          >
            首页
            <span class={`absolute bottom-0 left-0 w-full h-0.5 bg-purple-600 dark:bg-purple-400 transition-all duration-200 ${isActive('/') ? 'scale-100' : 'scale-0 group-hover:scale-100'}`}></span>
          </a>
        </div>

        <div class="relative group">
          <button class="inline-flex items-center px-1 pt-1 text-sm font-medium text-gray-900 dark:text-white hover:text-purple-600 dark:hover:text-purple-400">
            产品与服务
            <svg class="ml-1 h-4 w-4" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
            </svg>
            <span class={`absolute bottom-0 left-0 w-full h-0.5 bg-purple-600 dark:bg-purple-400 transition-all duration-200 ${isSectionActive('/products') || isSectionActive('/services') ? 'scale-100' : 'scale-0 group-hover:scale-100'}`}></span>
          </button>
          <div class="absolute left-0 top-full mt-2 w-80 rounded-xl bg-white dark:bg-gray-800 shadow-xl ring-1 ring-gray-200 dark:ring-gray-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="p-2">
              <p class="px-3 pt-1 pb-1 text-xs font-semibold tracking-wider text-purple-600 dark:text-purple-400">产品</p>
              <a href="/products/laundry" class="flex items-center gap-3 rounded-lg px-3 py-2.5 transition-colors hover:bg-purple-50 dark:hover:bg-gray-700">
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-purple-100 dark:bg-purple-900/40 text-xl">🚿</span>
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-gray-900 dark:text-white">净衣宝</span>
                  <span class="block truncate text-xs text-gray-500 dark:text-gray-400">洗衣 · 净水设备</span>
                </span>
              </a>

              <p class="px-3 pt-2 pb-1 text-xs font-semibold tracking-wider text-blue-600 dark:text-blue-400">服务</p>
              <a href="/services/care" class="flex items-center gap-3 rounded-lg px-3 py-2.5 transition-colors hover:bg-blue-50 dark:hover:bg-gray-700">
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-blue-100 dark:bg-blue-900/40 text-xl">👵</span>
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-gray-900 dark:text-white">居家康养服务</span>
                  <span class="block truncate text-xs text-gray-500 dark:text-gray-400">24小时专业陪护</span>
                </span>
              </a>

              <p class="px-3 pt-2 pb-1 text-xs font-semibold tracking-wider text-emerald-600 dark:text-emerald-400">公益</p>
              <a href="/services/insurance" class="flex items-center gap-3 rounded-lg px-3 py-2.5 transition-colors hover:bg-emerald-50 dark:hover:bg-gray-700">
                <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-emerald-100 dark:bg-emerald-900/40 text-xl">🛡️</span>
                <span class="min-w-0">
                  <span class="block text-sm font-medium text-gray-900 dark:text-white">孝行天下 康复无忧</span>
                  <span class="block truncate text-xs text-gray-500 dark:text-gray-400">养老公益行动</span>
                </span>
              </a>
            </div>
          </div>
        </div>

        <div class="relative group">
          <a 
            href="/cases" 
            class={`inline-flex items-center px-1 pt-1 text-sm font-medium ${isSectionActive('/cases') ? 'text-purple-600 dark:text-purple-400' : 'text-gray-900 dark:text-white hover:text-purple-600 dark:hover:text-purple-400'}`}
          >
            成功案例
            <span class={`absolute bottom-0 left-0 w-full h-0.5 bg-purple-600 dark:bg-purple-400 transition-all duration-200 ${isSectionActive('/cases') ? 'scale-100' : 'scale-0 group-hover:scale-100'}`}></span>
          </a>
        </div>

        <div class="relative group">
          <a 
            href="/about" 
            class={`inline-flex items-center px-1 pt-1 text-sm font-medium ${isSectionActive('/about') ? 'text-purple-600 dark:text-purple-400' : 'text-gray-900 dark:text-white hover:text-purple-600 dark:hover:text-purple-400'}`}
          >
            关于我们
            <span class={`absolute bottom-0 left-0 w-full h-0.5 bg-purple-600 dark:bg-purple-400 transition-all duration-200 ${isSectionActive('/about') ? 'scale-100' : 'scale-0 group-hover:scale-100'}`}></span>
          </a>
        </div>

        <div class="relative group">
          <a 
            href="/contact" 
            class={`inline-flex items-center px-1 pt-1 text-sm font-medium ${isSectionActive('/contact') ? 'text-purple-600 dark:text-purple-400' : 'text-gray-900 dark:text-white hover:text-purple-600 dark:hover:text-purple-400'}`}
          >
            联系我们
            <span class={`absolute bottom-0 left-0 w-full h-0.5 bg-purple-600 dark:bg-purple-400 transition-all duration-200 ${isSectionActive('/contact') ? 'scale-100' : 'scale-0 group-hover:scale-100'}`}></span>
          </a>
        </div>

        <a 
          href="https://ding-tai.cn/admin/login" target="_blank" rel="noopener noreferrer"
          class="ml-4 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-purple-600 hover:bg-purple-700 transition-colors"
        >
          登录
        </a>
      </nav>
      
      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button id="mobile-menu-button" type="button" aria-controls="mobile-menu" aria-expanded="false" class="inline-flex items-center justify-center p-2 rounded-md text-gray-700 dark:text-gray-300 hover:text-purple-600 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none">
          <span class="sr-only">打开主菜单</span>
          <svg id="mobile-icon-open" class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="mobile-icon-close" class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu panel -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-lg">
      <nav class="px-4 py-4 space-y-1">
        <a href="/" class="block rounded-md px-3 py-2 text-base font-medium text-gray-900 dark:text-white hover:bg-gray-100 dark:hover:bg-gray-800">首页</a>

        <p class="px-3 pt-2 pb-1 text-xs font-semibold tracking-wider text-purple-600 dark:text-purple-400">产品与服务</p>
        <a href="/products/laundry" class="block rounded-md px-3 py-2 pl-6 text-base text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">净衣宝</a>
        <a href="/services/care" class="block rounded-md px-3 py-2 pl-6 text-base text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">居家康养服务</a>
        <a href="/services/insurance" class="block rounded-md px-3 py-2 pl-6 text-base text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800">孝行天下 康复无忧</a>

        <a href="/cases" class="block rounded-md px-3 py-2 text-base font-medium text-gray-900 dark:text-white hover:bg-gray-100 dark:hover:bg-gray-800">成功案例</a>
        <a href="/about" class="block rounded-md px-3 py-2 text-base font-medium text-gray-900 dark:text-white hover:bg-gray-100 dark:hover:bg-gray-800">关于我们</a>
        <a href="/contact" class="block rounded-md px-3 py-2 text-base font-medium text-gray-900 dark:text-white hover:bg-gray-100 dark:hover:bg-gray-800">联系我们</a>

        <a href="https://ding-tai.cn/admin/login" target="_blank" rel="noopener noreferrer" class="mt-2 block rounded-md px-3 py-2 text-center text-base font-medium text-white bg-purple-600 hover:bg-purple-700">登录</a>
      </nav>
    </div>
  </div>
</header>

<script>
  (() => {
    const init = () => {
      const btn = document.getElementById('mobile-menu-button');
      const menu = document.getElementById('mobile-menu');
      const icOpen = document.getElementById('mobile-icon-open');
      const icClose = document.getElementById('mobile-icon-close');
      if (!btn || !menu) return;
      const setOpen = (v) => {
        menu.classList.toggle('hidden', !v);
        if (icOpen) icOpen.classList.toggle('hidden', v);
        if (icClose) icClose.classList.toggle('hidden', !v);
        btn.setAttribute('aria-expanded', String(v));
      };
      btn.addEventListener('click', (e) => { e.stopPropagation(); setOpen(menu.classList.contains('hidden')); });
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      document.addEventListener('click', (e) => {
        if (!menu.classList.contains('hidden') && !btn.contains(e.target) && !menu.contains(e.target)) setOpen(false);
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
