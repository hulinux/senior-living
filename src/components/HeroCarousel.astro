---
interface Props {}

const {} = Astro.props;

// 滚动背景轮播（3 张）。结构全部用自包含 scoped CSS 实现：
// 显式高度(460px) + 绝对定位 inset:0 铺满(object-fit:cover)。
// 不依赖 Tailwind、不依赖百分比高度链——Chrome/Safari/国产内核、
// 深色/浅色模式下都不会把图塌成 0 高度露出黑底。
const carouselImages = [
  {
    src: "/images/love-and-joy.jpeg",
    alt: "老年生活服务场景1",
    title: "我国已进入老龄社会",
    description: "让老年人老有所养、生活幸福、健康长寿是我们的共同愿望",
  },
  {
    src: "/images/smiling-asian-woman.jpg",
    alt: "老年生活服务场景2",
    title: "养老“心”模式",
    description: '用“孝心、真心和耐心”打造“长者舒心，家人安心和社会放心”',
  },
  {
    src: "/images/hero3.jpg",
    alt: "老年生活服务场景3",
    title: "“孝行天下 康复无忧”养老公益行动",
    description: "是一项利国利民的普惠性、公益性系统工程和民生工程",
  },
];
---

<div class="hero" data-carousel-wrapper>
  <div class="slideshow">
    <div class="track">
      {
        carouselImages.map((image) => (
          <div class="slide">
            <img src={image.src} alt={image.alt} class="slide-img" loading="lazy" />
            <div class="slide-overlay">
              <h1 class="slide-title">{image.title}</h1>
              <h3 class="slide-desc">{image.description}</h3>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 460px;
    overflow: hidden;
    background: #1f2937; /* 图没加载时的兜底，不再是纯黑 */
  }
  .slideshow {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }
  .track {
    display: flex;
    width: 300%;
    height: 460px;
    animation: hero-slide 15s ease-in-out 2s infinite alternate;
  }
  .slide {
    position: relative;
    width: 33.3333%;
    height: 460px;
    flex: 0 0 33.3333%;
  }
  .slide-img {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .slide-overlay {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #ffffff;
    padding: 0 1rem;
  }
  .slide-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1.2;
  }
  .slide-desc {
    font-size: 1.375rem;
    max-width: 42rem;
    margin: 0;
    line-height: 1.5;
  }
  @media (min-width: 768px) {
    .slide-title {
      font-size: 3rem;
    }
    .slide-desc {
      font-size: 1.5rem;
    }
  }
  @keyframes hero-slide {
    0%,
    28% {
      transform: translateX(0);
    }
    36%,
    64% {
      transform: translateX(-33.3333%);
    }
    72%,
    100% {
      transform: translateX(-66.6667%);
    }
  }
</style>
