---
import DefaultLayout from '../layouts/DefaultLayout.astro';
---

<DefaultLayout title="页面未找到 - 银龄生活" description="您访问的页面不存在">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <p class="text-6xl md:text-7xl font-extrabold text-purple-600 dark:text-purple-400 mb-4">404</p>
    <h1 class="text-3xl font-semibold text-gray-900 dark:text-white mb-3">页面未找到</h1>
    <p class="text-gray-600 dark:text-gray-300 mb-8">您访问的页面不存在，或已被移动。</p>
    <a href="/" class="inline-block px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition-colors">
      返回首页
    </a>
  </main>
</DefaultLayout>
