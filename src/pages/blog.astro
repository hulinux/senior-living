---
import "../styles/global.css"
import BaseLayout from "../layouts/BaseLayout.astro"
const raw = import.meta.glob("../pages/posts/*.md", { eager: true })
const allPosts = Object.entries(raw).map(([path, mod]) => {
  const name = path.split("/").pop().replace(/\.md$/, "")
  return { url: `/posts/${name}`, frontmatter: mod.frontmatter ?? mod.default?.frontmatter ?? {} }
})
const pageTitle = "我的 Astro 学习博客"
---

<body>
  <BaseLayout pageTitle={pageTitle}>
    <h1>我的 Astro 网站</h1>
    <h1>我的 Astro 学习博客</h1>
    <p>在这里，我将分享我的学习 Astro 之旅。</p>
    <ul>
      {
        allPosts.map((post) => (
          <li>
            <a href={post.url}>{post.frontmatter.title}</a>
          </li>
        ))
      }
    </ul>
  </BaseLayout>
  <script>
    import "../scripts/menu.js"
  </script>
</body>
